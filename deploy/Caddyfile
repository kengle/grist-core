{$GRIST_SITE_DOMAIN} {
	tls internal

	# Authelia portal: must stay unauthenticated, or the login page loops.
	handle /authelia* {
		reverse_proxy authelia:9091
	}
	# The MCP bridge answers its own 401 and serves its metadata document.
	handle /mcp* {
		reverse_proxy grist:8765
	}
	handle /.well-known/oauth-protected-resource {
		reverse_proxy grist:8765
	}
	# First-run setup: Grist's own boot key is the gate here, so no forward_auth.
	handle /boot* {
		reverse_proxy grist:8484
	}
	# First visit: no Grist session yet, so bind one at /auth/login before serving the app.
	# Every passthrough the app needs is excluded, and /auth* is never redirected, which is
	# what keeps this from looping.
	@needsSession {
		header Accept *text/html*
		not header Cookie *{$GRIST_SESSION_COOKIE:grist_core}*
		not path /auth* /api* /boot* /authelia* /mcp* /.well-known* /assets* /v/* /static* /fonts* /favicon* /forms* /s/* /download* /attachment*
	}
	redir @needsSession /auth/login?next={uri} 302

	# Everything else is a browser path behind Authelia.
	handle {
		forward_auth authelia:9091 {
			uri /authelia/api/authz/forward-auth
			copy_headers Remote-User Remote-Email Remote-Groups
		}
		reverse_proxy grist:8484 {
			header_up Host {http.request.hostport}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {http.request.hostport}
		}
	}
}
