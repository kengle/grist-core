# Copy to grist.env (mode 600, gitignored). Values below are placeholders.
GRIST_SESSION_SECRET=<REPLACE_ME>
GRIST_DEFAULT_EMAIL=<YOU>@<YOUR_DOMAIN>
GRIST_SANDBOX_FLAVOR=unsandboxed
GRIST_ORG_IN_PATH=true
GRIST_SERVE_SAME_ORIGIN=true
GRIST_HOST=0.0.0.0
GRIST_DATA_DIR=/persist/docs
GRIST_INST_DIR=/persist
GRIST_SESSION_COOKIE=grist_core
GRIST_ALLOW_AUTOMATIC_VERSION_CHECKING=false
GRIST_EXT_FULL_EDITION_BASE_URL=https://grist-static.com/grist-full-edition
GVISOR_FLAGS=-unprivileged -ignore-cgroups
NODE_OPTIONS=--no-deprecation --disable-proto=delete
NODE_ENV=production
TYPEORM_DATABASE=/persist/home.sqlite3
TZ=Asia/Shanghai
APP_HOME_URL=https://<YOUR_DOMAIN>/
APP_HOME_INTERNAL_URL=http://127.0.0.1:8484/
GRIST_FORWARD_AUTH_HEADER=Remote-Email
GRIST_FORWARD_AUTH_LOGOUT_PATH=/authelia/logout
GRIST_TEMPLATE_ORG=<OPTIONAL_TEMPLATE_ORG_DOMAIN>
GRIST_OIDC_JWKS_URL=http://authelia:9091/authelia/jwks.json
GRIST_OIDC_ISSUER=https://<YOUR_DOMAIN>/authelia
GRIST_OIDC_AUDIENCE=https://<YOUR_DOMAIN>
GRIST_OIDC_EMAIL_CLAIM=email
GRIST_API_BASE=http://127.0.0.1:8484/api
MCP_RESOURCE_URL=https://<YOUR_DOMAIN>
